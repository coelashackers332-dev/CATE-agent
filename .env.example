# Copy to .env. Never commit .env: it holds real phone numbers and secrets.
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Protects the projector view, /reset, the /dev routes and the phone line (/local/stream). Empty = a random one is printed at startup.
ADMIN_SECRET=
# demo = first booking ref is K7Q2XM so slides and screens match
DEMO_MODE=1
# The phone that plays Mr Wong (E.164, e.g. +85291234567). Mapped to member DEMO-0001 at startup.
DEMO_CALLER_NUMBER=
# The inbox of the teammate who plays Mr Wong: his texts go here when TEXTS=email
DEMO_CALLER_EMAIL=
# Daniel's real phone and email (team member's), overriding the placeholders in data/membership.json
DANIEL_PHONE=
DANIEL_EMAIL=
# log = print texts/email to the console; live = send email for real
MESSAGES=log
# email = each text goes by email to the address on file for that number; sms = no SMS sender (print only)
TEXTS=email
# The mail account that sends live email: a Gmail address and its 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# page = the pay email and the trip page link to the demo pay page /pay/<code> (no money moves); sms = "Reply PAY" by text (needs an SMS line); on stage POST /dev/pay also marks it paid. stripe = not built
PAYMENT=page
# scripted = no voice, plays the golden path; nova = Amazon Nova 2 Sonic (MODEL=nova needs the AWS lines below)
MODEL=scripted
# keyword = word matching over knowledge/*.md; embeddings = Bedrock (not built yet)
KNOWLEDGE=keyword
# Amazon Nova 2 Sonic (MODEL=nova). The AWS profile with Bedrock access; Nova 2 Sonic is in-region only.
AWS_PROFILE=
AWS_REGION=ap-northeast-1
# Optional: voice (default tiffany) and how soon a pause ends the caller's turn (HIGH | MEDIUM | LOW, default MEDIUM)
NOVA_VOICE=
NOVA_ENDPOINTING=
