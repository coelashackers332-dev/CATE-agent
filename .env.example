# Copy to .env. Never commit .env: it holds real phone numbers and secrets.
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Protects the projector view, /reset and /dev routes. Empty = a random one is printed at startup.
ADMIN_SECRET=
# demo = first booking ref is K7Q2XM so slides and screens match
DEMO_MODE=1
# The phone that plays Mr Wong (E.164, e.g. +85291234567). Mapped to member DEMO-0001 at startup.
DEMO_CALLER_NUMBER=
# The inbox of the teammate who plays Mr Wong: his texts go here when TEXTS=email
DEMO_CALLER_EMAIL=
# Daniel's real phone and email (team member's), overriding the placeholders in data/membership.json
DANIEL_PHONE=
DANIEL_EMAIL=
# log = print SMS/email to the console; live = send through Twilio / email
MESSAGES=log
# sms = texts go through Twilio; email = each text goes by email to the address on file for that number
# (use email while the Twilio number cannot send texts)
TEXTS=sms
# The mail account that sends live email: a Gmail address and its 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# sms = Daniel replies PAY; stripe = Stripe test checkout (not built yet)
PAYMENT=sms
# scripted = no voice, plays the golden path; nova = Amazon Nova 2 Sonic (not built yet)
MODEL=scripted
# keyword = word matching over knowledge/*.md; embeddings = Bedrock (not built yet)
KNOWLEDGE=keyword
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_NUMBER=
